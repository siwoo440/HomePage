{
  "name": "my-project",
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib scripts tests proxy.ts next.config.mjs postcss.config.mjs eslint.config.mjs --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "supabase:check": "node scripts/check-supabase-env.mjs",
    "services:check": "node scripts/check-services.mjs",
    "supabase:sql": "node scripts/build-supabase-setup.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --strict",
    "pages:apply": "node scripts/apply-static-pages.mjs",
    "pages:check": "node scripts/apply-static-pages.mjs --check",
    "images:games": "node scripts/optimize-game-images.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "1.6.1",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5",
    "sharp": "0.34.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  }
}
